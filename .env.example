# Used by Docker Compose and by the API when exported to the current shell.
ACCEPT_EULA=Y
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=TaskManagement
DB_USER=sa
DB_PASSWORD=Your_password123
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false

# Optional: set this instead of DB_* variables to provide a full connection string.
# ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=TaskManagement;User Id=sa;Password=Your_password123;TrustServerCertificate=True;Encrypt=False;
